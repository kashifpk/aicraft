#!/usr/bin/env bash
# direnv config — auto-activates the local venv and loads .env if present.
# Run `direnv allow` once after editing this file.

# Activate the project venv (created via `uv venv`).
if [[ -f .venv/bin/activate ]]; then
  source .venv/bin/activate
else
  echo "direnv: .venv/ not found — run 'uv venv && uv pip install -e \".[dev]\"'" >&2
fi

# Load provider keys / config from .env if it exists.
# .env is gitignored — put OPENROUTER_API_KEY, ANTHROPIC_API_KEY, etc. there.
if [[ -f .env ]]; then
  dotenv .env
fi
